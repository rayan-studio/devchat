# Base PostgreSQL (docker compose up -d la lance en local)
DATABASE_URL="postgresql://devchat:devchat@localhost:5432/devchat"

# Port du serveur API + temps réel
PORT=4000

# Adresse de l'interface web (pour CORS et la redirection après connexion)
WEB_URL="http://localhost:3000"

# Clé secrète pour signer les jetons de session : mets une longue chaîne aléatoire
# (par exemple : openssl rand -hex 32)
JWT_SECRET="change-moi"

# Application OAuth GitHub : https://github.com/settings/developers
# Callback URL à déclarer : http://localhost:4000/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
SERVER_URL="http://localhost:4000"

# Connexion de test sans GitHub (à laisser sur false en production)
DEV_LOGIN=true
